# Mission-owned folders: they belong to whichever mission uses hotload, never to the tool.
# Running hotload straight from this folder must not commit mission scripts or mailbox traffic.
/user-*/

# Local working space: specs and plans before they become a .tracker/ spec.
/.drafts/

# Lint tools, fetched at pinned versions by .github/scripts/lint.sh.
/.tools/

# The release package that .github/scripts/package.sh builds.
/dist/
